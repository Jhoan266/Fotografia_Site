generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  DRAFT
  DELIVERED
  ARCHIVED
}

enum SelectionStatus {
  SELECTED
  REJECTED
}

enum OrderStatus {
  UNPAID
  PAID
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  editorialDesigner Boolean @default(false)
  passwordHash  String
  mustChangePassword Boolean @default(false)
  lastTotpStep  Int?
  name          String
  role          Role
  locale        String         @default("es")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clientProfile ClientProfile?
  favorites     Favorite[]
  comments      Comment[]
  selections    Selection[]
  orders        Order[]
  sessions      AuthSession[]
  recoveryToken PasswordRecoveryToken? @relation("RecoveryTarget")
  issuedRecoveryTokens PasswordRecoveryToken[] @relation("RecoveryIssuer")
}

model PasswordRecoveryToken {
  tokenHash String @id
  userId String @unique
  user User @relation("RecoveryTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuerId String
  issuer User @relation("RecoveryIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ClientProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  downloadsEnabled Boolean @default(false)
  watermarkEnabled Boolean @default(true)
  watermarkText String @default("VISTA PREVIA")
  deliveryLogs PhotoDeliveryLog[]
  expiresAt DateTime?
  coverPhotoId String?
  coverPhoto Photo? @relation("GalleryCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  albums GalleryAlbum[]
  selectionVersion Int @default(0)
  selectionConfirmedAt DateTime?
  selectionSubmissions SelectionSubmission[]
  title       String
  description String?
  sessionDate DateTime?
  status      ProjectStatus @default(DRAFT)
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  photos      Photo[] @relation("ProjectPhotos")
  packs       ProjectPack[]
  orders      Order[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PhotoDeliveryLog {
  id String @id
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId String
  clientCode String
  photoId String?
  filename String
  kind String
  photoCount Int @default(1)
  requests Int @default(1)
  firstAt DateTime @default(now())
  lastAt DateTime @default(now())
  @@index([projectId, lastAt])
}

model SelectionSubmission {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId String
  version Int
  items Json
  createdAt DateTime @default(now())
  @@unique([projectId, version])
}

model Photo {
  trashedAt  DateTime?
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation("ProjectPhotos", fields: [projectId], references: [id], onDelete: Cascade)
  albumId String?
  album GalleryAlbum? @relation(fields: [albumId, projectId], references: [id, projectId], onDelete: NoAction, onUpdate: NoAction)
  coverFor Project[] @relation("GalleryCover")
  storageKey String
  thumbKey   String?
  filename   String
  width      Int?
  height     Int?
  sortOrder  Int         @default(0)
  favorites  Favorite[]
  comments   Comment[]
  selections Selection[]
  createdAt  DateTime    @default(now())

  @@index([projectId, trashedAt])
  @@index([albumId, projectId])
}

model GalleryAlbum {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name String
  sortOrder Int @default(0)
  photos Photo[]
  @@unique([id, projectId])
  @@index([projectId, sortOrder])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, photoId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  photoId   String
  body      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Selection {
  id        String          @id @default(cuid())
  userId    String
  photoId   String
  status    SelectionStatus @default(SELECTED)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo     Photo           @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, photoId])
}

model Pack {
  id          String        @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  currency    String        @default("EUR")
  active      Boolean       @default(true)
  projects    ProjectPack[]
  orders      Order[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ProjectPack {
  projectId String
  packId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([projectId, packId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  projectId   String
  packId      String
  status      OrderStatus @default(UNPAID)
  amountCents Int
  currency    String      @default("EUR")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pack        Pack        @relation(fields: [packId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model AuthSession {
  tokenHash          String    @id
  userId             String
  expiresAt          DateTime
  adminVerified      Boolean   @default(false)
  vaultVerifiedUntil DateTime?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

enum PhotoAuditAction {
  ZIP_REQUESTED
  PHOTO_DELETED
  PHOTO_TRASHED
  PHOTO_RESTORED
}

model PhotoAuditEvent {
  id         String           @id @default(cuid())
  actorId    String
  projectId  String
  photoId    String?
  photoCount Int
  action     PhotoAuditAction
  createdAt  DateTime         @default(now())

  @@index([projectId, createdAt])
}

model EditorialModule {
  id String @id
  revision Int @default(0)
  draft Json
  published Json?
  updatedAt DateTime @updatedAt
}

model EditorialRevision {
  id String @id @default(cuid())
  moduleId String
  revision Int
  action String
  actorId String
  content Json
  createdAt DateTime @default(now())
  @@index([moduleId, createdAt])
}

model EditorialAsset {
  id String @id @default(cuid())
  storageKey String @unique
  mime String
  filename String
  createdAt DateTime @default(now())
}
