# Database
DATABASE_URL="postgresql://fotografia:fotografia@localhost:5432/fotografia?schema=public"

# Session (min 32 characters)
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Storage: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Optional S3 / MinIO (use with docker compose --profile minio)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fotografia"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
