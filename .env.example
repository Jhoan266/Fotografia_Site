# Database
POSTGRES_USER="fotografia"
POSTGRES_PASSWORD="replace_me_with_a_strong_database_password"
POSTGRES_DB="fotografia"
DATABASE_URL="postgresql://fotografia:replace_me_with_a_strong_database_password@localhost:5432/fotografia?schema=public"

# Session (use a cryptographically random value, 32+ characters)
SESSION_SECRET="replace_me_with_a_random_secret_of_at_least_32_characters"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Demo data. Never enable in production.
RUN_DEMO_SEED="false"

# Storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Optional MinIO profile (S3 adapter is not implemented yet)
MINIO_ROOT_USER="replace_me"
MINIO_ROOT_PASSWORD="replace_me_with_a_strong_minio_password"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="fotografia"
S3_ACCESS_KEY="replace_me"
S3_SECRET_KEY="replace_me"
S3_FORCE_PATH_STYLE="true"
